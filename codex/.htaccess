# Revalidate every load (no-cache) so a deploy lands on the next page load, no
# hard-refresh, covers ES sub-imports, keeps CSS+JS in sync. max-age=60 to trim 304s.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
