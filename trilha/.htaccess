# Revalidate every load (no-cache) so a deploy reaches students on the next page
# load (the Trail entry HTML; its JS/CSS load from /codex/, covered by codex/.htaccess).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /trilha/

# ── Certificate validation routes (MUST precede the generic two-segment rule) ──
# /trilha/validar/<code> -> validar.html?code=<code>
RewriteRule ^validar/([A-Za-z0-9-]+)/?$ validar.html?code=$1 [QSA,L]
# /trilha/validar  (bare path, shows manual code-entry form)
RewriteRule ^validar/?$ validar.html [L]

# ── Typed enrollment entry (MUST precede the generic two-segment rule) ──
# /trilha/<4-digit code> -> entrar.html?code=NNNN (typed-entry, resolves to the live turma)
RewriteRule ^([0-9]{4})/?$ entrar.html?code=$1 [QSA,L]
# /trilha/entrar  (bare path, manual code-entry form)
RewriteRule ^entrar/?$ entrar.html [L]

# Rewrite /trilha/<client>/<turma>[/] to index.html, preserving ?k=token
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9_-]+)/([a-z0-9_-]+)/?$ index.html?c=$1&t=$2 [QSA,L]
